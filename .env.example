# Providers use environment-variable references. Never place secret values in an
# experiment manifest or reproducibility bundle.
AZURE_FOUNDRY_ENDPOINT=
# Optional: omit this and credential_env to use Microsoft Entra ID.
AZURE_FOUNDRY_API_KEY=

# OpenAI-compatible Chat Completions (Ollama, vLLM, llama.cpp, Groq, OpenAI, …).
# Leave empty for the local default http://localhost:11434/v1 with no API key.
OPENAI_BASE_URL=
# Optional. Required only for hosted endpoints; local servers can omit this.
OPENAI_API_KEY=
