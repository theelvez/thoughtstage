# Copy to .env in the repo root. .env is gitignored.
# Set values only in .env or in the current process. Never put them in YAML.
# Mock needs none of these. Paid providers are opt-in.
#
# The local launcher (scripts/dev.ps1 or scripts/dev.sh) loads .env into the
# same process as thoughtstage serve. Existing process values win.

# Microsoft Foundry. Full resource URL, not a key. Entra is the default.
# Optional API-key name if you are not using Entra: AZURE_FOUNDRY_API_KEY
AZURE_FOUNDRY_ENDPOINT=

# Amazon Bedrock. AWS profile name, not an access key.
THOUGHTSTAGE_AWS_PROFILE=

# OpenAI-compatible hosted Chat Completions. Local Ollama can leave both empty.
OPENAI_BASE_URL=
OPENAI_API_KEY=
